ooks/data_table.ipynb>data table notebook</a>'\n","          + ' to learn more about interactive tables.';\n","        element.innerHTML = '';\n","        dataTable['output_type'] = 'display_data';\n","        await google.colab.output.renderOutput(dataTable, element);\n","        const docLink = document.createElement('div');\n","        docLink.innerHTML = docLinkHtml;\n","        element.appendChild(docLink);\n","      }\n","    </script>\n","  </div>\n","\n","\n","    </div>\n","  </div>\n"],"text/plain":["            Experiment  Scratch RMSE  Sklearn RMSE  Scratch R2  Sklearn R2\n","0             Baseline       26.0852       26.0852      0.5906      0.5906\n","1        Normalization       26.0852       26.0852      0.5906      0.5906\n","2  Normalization + PCA       30.7825       30.7825      0.4299      0.4299"]},"execution_count":36,"metadata":{},"output_type":"execute_result"}],"source":["linear_sklearn_results = pd.DataFrame({\n","\n","    \"Experiment\": [\n","        \"Baseline\",\n","        \"Normalization\",\n","        \"Normalization + PCA\"\n","    ],\n","\n","    \"Scratch RMSE\": [\n","        rmse_baseline,\n","        rmse_scaled,\n","        rmse\n","    ],\n","\n","    \"Sklearn RMSE\": [\n","        rmse_sk_baseline,\n","        rmse_sk_norm,\n","        rmse_sk_pca\n","    ],\n","\n","    \"Scratch R2\": [\n","        r2_baseline,\n","        r2_scaled,\n","        r2\n","    ],\n","\n","    \"Sklearn R2\": [\n","        r2_sk_baseline,\n","        r2_sk_norm,\n","        r2_sk_pca\n","    ]\n","\n","})\n","\n","\n","linear_sklearn_results.round(4)"]},{"cell_type":"markdown","metadata":{"id":"MA_7dUQhTUaN"},"source":["# Logistic Regression Mathematical Model\n","\n","Logistic Regression is used for binary classification problems. It first calculates a linear combination of the input features:\n","\n","z = Xw + b\n","\n","Then, the sigmoid function is applied to convert this value into a probability:\n","\n","σ(z) = 1 / (1 + e⁻ᶻ)\n","\n","Where:\n","\n","- X represents the input features.\n","- w represents the learned weights.\n","- b represents the bias value.\n","- σ(z) represents the probability of belonging to class 1.\n","\n","The final prediction is determined using a threshold:\n","- If the probability ≥ 0.5, the sample is classified as Class 1.\n","- Otherwise, it is classified as Class 0."]},{"cell_type":"markdown","metadata":{"id":"wJ3XOKkyxd9e"},"source":["## Logistic Regression From Scratch\n","\n","Logistic Regression was implemented from scratch using NumPy.\n","\n","The model was trained using Gradient Descent to classify whether a hotel booking is canceled or not."]},{"cell_type":"code","execution_count":null,"metadata":{"id":"RpGOBIHfxg2o"},"outputs":[],"source":["# دالة Sigmoid\n","def sigmoid(z):\n","    return 1 / (1 + np.exp(-z))\n","# إنشاء الكلاس\n","class LogisticRegressionScratch:\n","\n","    def __init__(self, learning_rate=0.01, epochs=1000):\n","        self.learning_rate = learning_rate\n","        self.epochs = epochs\n","        self.weights = None\n","        self.bias = 0\n","\n","    def fit(self, X, y):\n","\n","        X = np.asarray(X, dtype=np.float64)\n","        y = np.asarray(y, dtype=np.float64)\n","\n","        n_samples, n_features = X.shape\n","\n","        self.weights = np.zeros(n_features)\n","        self.bias = 0\n","\n","        for _ in range(self.epochs):\n","\n","            linear = np.dot(X, self.weights) + self.bias\n","\n","            predictions = sigmoid(linear)\n","\n","            dw = (1 / n_samples) * np.dot(X.T, (predictions - y))\n","            db = (1 / n_samples) * np.sum(predictions - y)\n","\n","            self.weights -= self.learning_rate * dw\n","            self.bias -= self.learning_rate * db\n","\n","    def predict(self, X):\n","\n","        X = np.asarray(X, dtype=np.float64)\n","\n","        probabilities = sigmoid(np.dot(X, self.weights) + self.bias)\n","\n","        return (probabilities >= 0.5).astype(int)"]},{"cell_t